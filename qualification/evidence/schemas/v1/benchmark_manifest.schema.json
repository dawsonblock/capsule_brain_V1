{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Benchmark Manifest",
  "type": "object",
  "required": ["run_id", "benchmark_digest", "n_tasks", "tasks"],
  "properties": {
    "run_id": {"type": "string"},
    "benchmark_digest": {"type": "string"},
    "n_tasks": {"type": "integer", "minimum": 0},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "family", "archetype", "eligible_actions"],
        "properties": {
          "task_id": {"type": "string"},
          "family": {"type": "string"},
          "archetype": {"type": "string"},
          "task_version": {"type": "string"},
          "eligible_actions": {"type": "array", "items": {"type": "string"}},
          "prompt_digest": {"type": "string"},
          "setup_digest": {"type": "string"},
          "hidden_setup_digest": {"type": "string"}
        }
      }
    }
  }
}
