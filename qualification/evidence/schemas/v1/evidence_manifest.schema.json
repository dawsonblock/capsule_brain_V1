{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Manifest",
  "type": "object",
  "required": [
    "evidence_package_version",
    "original_run_id",
    "original_package_version",
    "original_qualification_version",
    "model_id",
    "model_revision",
    "tokenizer_id",
    "tokenizer_revision",
    "provider_class",
    "runtime_type",
    "immutable",
    "scientific_result"
  ],
  "properties": {
    "evidence_package_version": {"type": "string"},
    "original_run_id": {"type": "string"},
    "original_package_version": {"type": "string"},
    "original_qualification_version": {"type": "string"},
    "original_commit_sha": {"type": ["string", "null"]},
    "model_id": {"type": "string"},
    "model_revision": {"type": "string"},
    "model_digest": {"type": ["string", "null"]},
    "tokenizer_id": {"type": "string"},
    "tokenizer_revision": {"type": "string"},
    "provider_class": {"type": "string", "enum": ["REAL_MODEL", "INFRASTRUCTURE", "SIMULATED"]},
    "runtime_type": {"type": "string"},
    "benchmark_sha256": {"type": "string"},
    "split_sha256": {"type": "string"},
    "counterfactuals_sha256": {"type": "string"},
    "candidate_policy_sha256": {"type": "string"},
    "sham_policy_sha256": {"type": "string"},
    "baseline_results_sha256": {"type": "string"},
    "candidate_results_sha256": {"type": "string"},
    "sham_results_sha256": {"type": "string"},
    "oracle_results_sha256": {"type": "string"},
    "gate_a_results_sha256": {"type": "string"},
    "source_provenance_sha256": {"type": "string"},
    "creation_timestamp": {"type": "string"},
    "immutable": {"type": "boolean"},
    "scientific_result": {"type": "string", "enum": ["positive", "negative", "inconclusive"]},
    "promoted": {"type": "boolean"}
  }
}
