{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Provenance",
  "type": "object",
  "required": ["source_tree_sha256", "source_file_count", "source_byte_count"],
  "properties": {
    "original_commit_sha": {"type": ["string", "null"]},
    "original_source_tree_sha256": {"type": "string"},
    "original_source_file_count": {"type": "integer"},
    "original_source_byte_count": {"type": "integer"},
    "original_qualification_source_sha256": {"type": "string"},
    "original_config_sha256": {"type": "string"},
    "original_dependency_lock_sha256": {"type": "string"},
    "original_benchmark_sha256": {"type": "string"},
    "original_provider_manifest_sha256": {"type": "string"},
    "source_tree_sha256": {"type": "string"},
    "source_file_count": {"type": "integer"},
    "source_byte_count": {"type": "integer"},
    "hash_algorithm_version": {"type": "string"}
  }
}
