{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Counterfactual Outcome",
  "type": "object",
  "required": [
    "schema_version", "run_id", "task_id", "split", "family", "archetype",
    "task_version", "prompt_digest", "setup_digest", "hidden_setup_digest",
    "eligible_action", "executed_action", "action_status", "runtime_type",
    "provider_class", "model_id", "model_revision", "tokenizer_id",
    "tokenizer_revision", "generation_config_digest", "generation_seed",
    "environment_snapshot_digest", "memory_state_digest", "tool_state_digest",
    "workflow_state_digest", "capability_permissions_digest",
    "timeout_config_digest", "verifier_name", "verifier_version",
    "verifier_class", "verified_success", "verification_evidence_digest",
    "utility", "utility_version", "utility_config_digest",
    "latency_ms", "input_tokens", "output_tokens",
    "error_type", "error_message", "created_at", "artifact_digest"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "split": {"type": "string", "enum": ["experience", "validation", "test", "ood", "safety"]},
    "family": {"type": "string"},
    "archetype": {"type": "string"},
    "task_version": {"type": "string"},
    "prompt_digest": {"type": "string"},
    "setup_digest": {"type": "string"},
    "hidden_setup_digest": {"type": "string"},
    "eligible_action": {"type": "string"},
    "executed_action": {"type": ["string", "null"]},
    "action_status": {"type": "string", "enum": ["EXECUTED", "NOT_EXECUTED", "EXECUTION_ERROR", "TIMEOUT", "UNVERIFIABLE"]},
    "runtime_type": {"type": "string"},
    "provider_class": {"type": "string"},
    "model_id": {"type": "string"},
    "model_revision": {"type": "string"},
    "tokenizer_id": {"type": "string"},
    "tokenizer_revision": {"type": "string"},
    "generation_config_digest": {"type": "string"},
    "generation_seed": {"type": ["integer", "string", "null"]},
    "environment_snapshot_digest": {"type": "string"},
    "memory_state_digest": {"type": "string"},
    "tool_state_digest": {"type": "string"},
    "workflow_state_digest": {"type": "string"},
    "capability_permissions_digest": {"type": "string"},
    "timeout_config_digest": {"type": "string"},
    "verifier_name": {"type": "string"},
    "verifier_version": {"type": "string"},
    "verifier_class": {"type": "string"},
    "verified_success": {"type": ["boolean", "null"]},
    "verification_evidence_digest": {"type": "string"},
    "utility": {"type": ["number", "null"]},
    "utility_version": {"type": "string"},
    "utility_config_digest": {"type": "string"},
    "latency_ms": {"type": ["number", "null"]},
    "input_tokens": {"type": ["integer", "null"]},
    "output_tokens": {"type": ["integer", "null"]},
    "error_type": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "artifact_digest": {"type": "string"}
  }
}
