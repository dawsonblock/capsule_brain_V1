# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Runtime databases (do not ship runtime state as source)
data/
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# Qualification runtime stores (regenerated by the harness on each run;
# never ship as source — keep only sanitized results in qual214/)
qual214/stores/
qual214/data/
qual214/**/*.sqlite
qual214/**/*.sqlite-wal
qual214/**/*.sqlite-shm
qual214/test11_container_result.json

# AutoLearn qualification: the policy registry and intermediate JSON
# artifacts are regenerated by the harness on each run. The final report
# (AUTOLEARN_V0_1_REPORT.md) and autolearn_results.json ARE committed as
# evidence; the rest is reproducible from the manifests and hashes.
qualification/autolearn/policies/
qualification/autolearn/counterfactuals.json
qualification/autolearn/dataset.json
qualification/autolearn/candidate_policy_id.txt

# Sandbox workspace
sandbox/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.cid
