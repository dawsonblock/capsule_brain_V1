# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Runtime databases (do not ship runtime state as source)
data/
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# Qualification runtime stores (regenerated by the harness on each run;
# never ship as source — keep only sanitized results in qual214/)
qual214/stores/
qual214/data/
qual214/**/*.sqlite
qual214/**/*.sqlite-wal
qual214/**/*.sqlite-shm
qual214/test11_container_result.json

# Sandbox workspace
sandbox/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.cid
